// HSU-AUTO-SCHEDULER — PostgreSQL 스키마 (v3, ddl_v2 MySQL → PostgreSQL)
//
// v2 대비 변경
//   1. major_course 에 semester_id 추가 (학기별 전공-과목 이수구분/학년)
//   2. grade_limit: major_course → lecture (학년제한은 분반 속성)
//   3. credit: course → lecture (학기별 학점 보존)
//   4. lecture.name 추가 (분반별 과목명, 예: "상상설계 진로1(상상더학기)")
//   5. lecture.classroom_raw 추가 (종정시 강의실/교시 원문, 재파싱용)
//   6. semester.scraped_at 추가 (데이터 기준 시각)
//   7. semester_major 제거 (major_course 에서 파생)
//   8. lecture.online_hour DECIMAL(2,1) 시간 → online_minutes smallint 분 (1.5시간 = 90)
//   9. MySQL 전용 타입 정리: BIGINT UNSIGNED AUTO_INCREMENT → bigint identity,
//      tinyint → smallint, ENUM → varchar + CHECK
//  10. ON DELETE CASCADE 는 학기 → (major_course, lecture), 분반 → offline_schedule 만.
//      course·major 를 가리키는 FK 는 RESTRICT (실수로 지워도 다른 학기 데이터가 사라지지 않게)
//
// 화면에 보이는 과목 정보(이름·학점·학년제한 …)는 모두 lecture 에서 읽는다.
// course 는 여러 학기에 걸쳐 "같은 과목"인지 판단하는 기준(과목코드 + 대표 이름)이다.
//
// enum 은 varchar + CHECK: JPA 는 @Enumerated(STRING) 로 바로 매핑되고,
// 값 추가·변경은 CHECK 만 고치면 된다. 요일 정렬은 앱에서 한다.
//
// API 응답은 v2 와 같은 모양을 유지한다 (프론트·OR-Tools 무수정):
//   online_hour = online_minutes / 60, grade_limits = [grade_limit], id 는 문자열로 직렬화

Project hsu_auto_scheduler {
  database_type: 'PostgreSQL'
  Note: '종정시(siganpyo_aui_data.jsp) 수집 데이터 기준. 2026-2 실측: 전공 110, 과목 778, 분반 1,489, 전공-과목 1,393, 시간표 1,502'
}

Table semester {
  id varchar(10) [pk, note: "'2026-2' (년도-학기)"]
  year smallint [not null]
  term smallint [not null, note: '1·2 정규, 3 여름, 4 겨울']
  scraped_at timestamptz [note: '종정시 수집 시각 (export 파일의 fetchedAt)']

  indexes {
    (year, term) [unique, name: 'uk_semester']
  }
  checks {
    `term between 1 and 4` [name: 'chk_semester_term']
    `id = year::text || '-' || term::text` [name: 'chk_semester_id']
  }
}

Table major {
  id bigint [pk, increment, note: 'generated by default as identity']
  code varchar(10) [not null, unique, note: '종정시 전공코드 (예: P012)']
  name varchar(100) [not null, note: "가장 최근 학기의 이름. 같은 이름이 다른 코드로 있을 수 있음 (예: '학점인정' L330, M050)"]
}

Table course {
  id bigint [pk, increment]
  code varchar(20) [not null, unique, note: '과목코드 (예: P010182)']
  name varchar(255) [not null, note: '대표 과목명: 분반들 중 가장 많이 쓰인 이름, 같으면 짧은 쪽. 화면 표시는 lecture.name']
}

// 학기마다 전공의 교육과정이 바뀌므로 semester_id 를 유니크 키에 포함한다.
// 한 전공 안에서 이수구분·학년은 분반과 무관하고(2026-2 실측 편차 0건),
// 전공은 항상 그 과목의 모든 분반을 함께 연다(편차 0건) → 분반이 아니라 과목 단위로 둔다.
Table major_course {
  id bigint [pk, increment]
  semester_id varchar(10) [not null]
  major_id bigint [not null]
  course_id bigint [not null]
  requirement_type varchar(30) [not null, note: 'MAJOR_REQUIRED 전필 / MAJOR_ELECTIVE 전선 / MAJOR_BASIC 전기 / GENERAL_REQUIRED 교필 / REQUIRED_GENERAL_ELECTIVE 선필교 / GENERAL_ELECTIVE 일교 / FREE_ELECTIVE 일선 / MD_MAJOR_ELECTIVE MD전선 / DOUBLE_MAJOR_ELECTIVE 복전선']
  grade smallint [not null, note: '1~4, 0 = 전학년']

  indexes {
    (semester_id, major_id, course_id) [unique, name: 'uk_major_course']
    (semester_id, course_id) [name: 'idx_major_course_semester_course', note: 'lecture 쪽에서 조인할 때']
  }
  checks {
    `requirement_type in ('MAJOR_REQUIRED', 'MAJOR_ELECTIVE', 'MAJOR_BASIC', 'GENERAL_REQUIRED', 'REQUIRED_GENERAL_ELECTIVE', 'GENERAL_ELECTIVE', 'FREE_ELECTIVE', 'MD_MAJOR_ELECTIVE', 'DOUBLE_MAJOR_ELECTIVE')` [name: 'chk_major_course_requirement_type']
    `grade between 0 and 4` [name: 'chk_major_course_grade']
  }
}

// 분반. 같은 분반은 어느 전공 목록에서 보든 강의 정보가 같다(2026-2 실측 편차 0건).
Table lecture {
  id bigint [pk, increment]
  semester_id varchar(10) [not null]
  course_id bigint [not null]
  section varchar(5) [not null, note: '분반 (A, N, 7, @ ...)']
  name varchar(255) [not null, note: '종정시에 보이는 분반의 과목명. 대부분 course.name 과 같다']
  credit smallint [not null, note: '학점 (실측 1, 2, 3, 4, 6, 9). 같은 과목의 분반끼리는 같다(편차 0건)']
  delivery_method varchar(20) [not null, note: 'FACE_TO_FACE 대면수업 / ONLINE 온라인100% / BLENDED BL']
  day_or_night varchar(10) [not null, note: 'DAY 주 / NIGHT 야 / BOTH 합']
  professors varchar(255) [not null, note: "쉼표 구분 원문 (예: '박종언,홍승진'). 미정은 '강사'"]
  online_minutes smallint [not null, default: 0, note: '온라인강좌 시간(분). "온라인강좌 1.5시간" → 90 (실측 60, 90, 120, 180, 240)']
  grade_limit smallint [note: '학년제한. 같은 과목이라도 분반마다 다름 (2026-2: 13개 과목)']
  plan_code varchar(30) [note: "수업계획서 코드. 'X'면 null"]
  remark varchar(100) [note: '비고 (수강인원, 컨설팅이수, PF과목, 학과신청, 수준별과목, 군사학)']
  classroom_raw text [not null, default: '', note: '종정시 classroom 원문 (예: "상상관503 월8M~9M / 상상관604 수8M~9M")']

  indexes {
    (semester_id, course_id, section) [unique, name: 'uk_lecture']
    course_id [name: 'idx_lecture_course']
  }
  checks {
    `credit > 0` [name: 'chk_lecture_credit']
    `delivery_method in ('FACE_TO_FACE', 'ONLINE', 'BLENDED')` [name: 'chk_lecture_delivery_method']
    `day_or_night in ('DAY', 'NIGHT', 'BOTH')` [name: 'chk_lecture_day_or_night']
    `online_minutes >= 0` [name: 'chk_lecture_online_minutes']
    `grade_limit between 1 and 4` [name: 'chk_lecture_grade_limit']
  }
}

Table offline_schedule {
  id bigint [pk, increment]
  lecture_id bigint [not null]
  day varchar(3) [not null, note: 'MON TUE WED THU FRI SAT SUN']
  start_time smallint [not null, note: '자정부터 분 (09:00 = 540)']
  end_time smallint [not null]
  place varchar(100) [not null]

  indexes {
    (lecture_id, day, start_time) [unique, name: 'uk_offline_schedule']
  }
  checks {
    `day in ('MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN')` [name: 'chk_offline_schedule_day']
    `start_time >= 0 and end_time <= 1440 and start_time < end_time` [name: 'chk_offline_schedule_time']
  }
}

// 학기를 지우면 그 학기 major_course·lecture·offline_schedule 이 같이 지워진다.
Ref: major_course.semester_id > semester.id [delete: cascade]
Ref: lecture.semester_id > semester.id [delete: cascade]
Ref: offline_schedule.lecture_id > lecture.id [delete: cascade]

// course·major 는 여러 학기가 공유하므로 참조 중이면 지울 수 없다.
Ref: major_course.major_id > major.id [delete: restrict]
Ref: major_course.course_id > course.id [delete: restrict]
Ref: lecture.course_id > course.id [delete: restrict]
